# Opcional: sem SMTP_HOST, o e-mail de alerta e gravado como .eml em data/runtime/emails.
# services/ le estas variaveis do ambiente do processo; exporte-as antes de iniciar a API.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
ALERTA_REMETENTE=cardioia@example.com
ALERTA_DESTINATARIO=equipe-cardiologia@example.com
