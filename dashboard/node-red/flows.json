  {
    "id": "ui_led",
    "type": "ui_template",
    "z": "tab_cardioia",
    "group": "ui_grp_estado",
    "name": "Indicador de alerta (LED virtual)",
    "order": 1,
    "width": "6",
    "height": "3",
    "format": "<style>\n .led-wrap { display:flex; align-items:center; gap:16px; height:100%; padding:0 8px; }\n .led { width:64px; height:64px; border-radius:50%; flex:none; background:#555; }\n .led-normal { background:#2ecc71; box-shadow:0 0 18px #2ecc71; }\n .led-atencao { background:#f1c40f; box-shadow:0 0 18px #f1c40f; }\n .led-critico { background:#e74c3c; box-shadow:0 0 26px #e74c3c; animation:pisca 1s infinite; }\n @keyframes pisca { 50% { opacity:.35; } }\n .led-titulo { font-size:22px; font-weight:600; }\n .led-detalhe { font-size:14px; opacity:.85; margin-top:4px; }\n</style>\n<div class=\"led-wrap\">\n  <div id=\"led-indicador\" class=\"led\" ng-class=\"'led-' + (msg.payload.nivel || 'aguardando')\"></div>\n  <div>\n    <div class=\"led-titulo\" ng-switch=\"msg.payload.nivel\">\n      <span ng-switch-when=\"critico\">ALERTA CRÍTICO</span>\n      <span ng-switch-when=\"atencao\">ATENÇÃO</span>\n      <span ng-switch-when=\"normal\">Normal</span>\n      <span ng-switch-when=\"semsinal\">Sem sinal de pulso</span>\n      <span ng-switch-when=\"semdados\">SEM DADOS</span>\n      <span ng-switch-default>Aguardando dados</span>\n    </div>\n    <div class=\"led-detalhe\" ng-if=\"msg.payload.alertas.length\">{{msg.payload.alertas.join(' + ')}}</div>\n    <div class=\"led-detalhe\" ng-if=\"msg.payload.nivel === 'semdados'\">Nenhuma leitura recente: o estado do paciente é desconhecido</div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 760,
    "y": 300,
    "wires": [
