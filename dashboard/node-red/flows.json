  {
    "id": "fn_watchdog",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Watchdog: sem dados ha 20 s",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 300,
    "func": "// Sem leitura recente, o painel nao pode continuar mostrando o ultimo verde:\n// \"nao sei\" e diferente de \"esta tudo bem\".\nconst ultima = flow.get('ultimaAmostraEm');\nif (!ultima || flow.get('semDados')) return null;\nif (Date.now() - ultima < 20000) return null;\nflow.set('semDados', true);\nreturn { payload: { nivel: 'semdados', alertas: [] } };\n",
