  {
    "id": "fn_historico",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Mantem os ultimos alertas",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 360,
    "func": "// Mantem os ultimos alertas, do mais recente para o mais antigo, com o horario de captura.\nconst lista = flow.get('historico') || [];\nconst a = msg.payload;\nconst hora = a.horaConhecida ? new Date(a.em).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'antes do reinicio';\nlista.unshift({ hora: hora, alertas: a.alertas.join(' + '), bpm: a.bpm, temp: a.temp, origem: a.replay ? 'Recuperado do buffer' : 'Tempo real' });\nlista.splice(12);\nflow.set('historico', lista);\nreturn { payload: lista };\n",
    "wires": [
      [
        "ui_historico"
      ]
    ]
  },
  {
    "id": "ui_historico",
    "type": "ui_template",
    "z": "tab_cardioia",
    "group": "ui_grp_estado",
    "name": "Tabela de alertas",
    "order": 7,
    "width": "12",
    "height": "6",
    "format": "<table style=\"width:100%; border-collapse:collapse; font-size:14px;\">\n  <thead><tr style=\"text-align:left;\"><th>Captura</th><th>Alerta</th><th>BPM</th><th>Temp (°C)</th><th>Origem</th></tr></thead>\n  <tbody>\n    <tr ng-repeat=\"a in msg.payload\" style=\"border-top:1px solid #555;\"><td>{{a.hora}}</td><td>{{a.alertas}}</td><td>{{a.bpm}}</td><td>{{a.temp | number:1}}</td><td>{{a.origem}}</td></tr>\n    <tr ng-if=\"!msg.payload.length\"><td colspan=\"5\" style=\"opacity:.7;\">Nenhum alerta registrado</td></tr>\n  </tbody>\n</table>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
