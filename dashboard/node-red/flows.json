  {
    "id": "fn_fog",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Fog: valida, data e classifica",
    "outputs": 8,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "outputLabels": [
      "BPM (grafico)",
      "Temperatura (grafico)",
      "Temperatura (gauge)",
      "BPM (gauge)",
      "Umidade/movimento (texto)",
      "Estado (LED)",
      "Historico",
      "Sincronizacao"
    ],
    "func": "// Camada Fog: reavalia os limites sem confiar so no dispositivo e separa o que e\n// \"agora\" do que e historico recuperado apos uma queda de conexao.\nconst LIM = { bpmAlto: 120, bpmBaixo: 50, tempFebre: 38.0 };\n\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null || typeof d.seq !== 'number') {\n    node.warn('Telemetria invalida descartada');\n    return null;\n}\n\n// age_s = ha quantos segundos a amostra foi capturada. null = veio de um boot anterior.\nconst temIdade = typeof d.age_s === 'number';\nconst capturadaEm = Date.now() - (temIdade ? d.age_s * 1000 : 0);\n\nconst criticos = [];\nif (d.bpm > LIM.bpmAlto) criticos.push('TAQUICARDIA');\nif (d.bpm > 0 && d.bpm < LIM.bpmBaixo) criticos.push('BRADICARDIA');\nif (typeof d.temp_c === 'number' && d.temp_c > LIM.tempFebre) criticos.push('FEBRE');\nconst atencao = (d.alertas || []).includes('IMOBILIDADE') ? ['IMOBILIDADE'] : [];\n\n// Sem horario confiavel, nao entra no grafico: apareceria como se tivesse acabado de ocorrer.\nconst bpmChart = temIdade ? { payload: d.bpm, topic: 'BPM', timestamp: capturadaEm } : null;\nconst tempChart = temIdade && typeof d.temp_c === 'number' ? { payload: d.temp_c, topic: 'Temperatura', timestamp: capturadaEm } : null;\n\nconst todos = criticos.concat(atencao);\nconst historico = todos.length ? { payload: { em: capturadaEm, horaConhecida: temIdade, seq: d.seq, bpm: d.bpm, temp: d.temp_c, alertas: todos, replay: !!d.replay } } : null;\n\nconst sinc = { payload: { fila: d.fila, replay: !!d.replay } };\n\n// Amostra recuperada vai ao grafico e ao historico, mas nao pode mover os indicadores\n// de \"agora\": um alerta de horas atras nao deve acender o LED como se fosse atual.\nif (d.replay) {\n    return [bpmChart, tempChart, null, null, null, null, historico, sinc];\n}\n\nflow.set('ultimaAmostraEm', Date.now());\nflow.set('semDados', false);\n\nconst nivel = criticos.length ? 'critico' : (atencao.length ? 'atencao' : (d.bpm === 0 ? 'semsinal' : 'normal'));\nconst estado = { payload: { nivel: nivel, alertas: todos, bpm: d.bpm, temp: d.temp_c } };\nconst tempGauge = typeof d.temp_c === 'number' ? { payload: d.temp_c } : null;\nconst bpmGauge = { payload: d.bpm };\nconst texto = { payload: (d.umid_pct === null ? '--' : d.umid_pct.toFixed(1) + ' %') + ' | ' + (d.mov_mg === null ? '--' : d.mov_mg + ' mg') };\n\nreturn [bpmChart, tempChart, tempGauge, bpmGauge, texto, estado, historico, sinc];\n",
    "wires": [
      [
        "ui_chart_bpm"
      ],
      [
        "ui_chart_temp"
      ],
